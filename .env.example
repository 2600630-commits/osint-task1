# OSINT API keys for the five tools compared by this project.
#
# Copy this file to `.env` and fill in the real values. `.env` is git-ignored;
# never commit real keys. Environment variables of the same name always win.
#
# Each key is free-tier capable - register an account with the provider
# and generate the token from the URLs below.

# VirusTotal   -> https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# SecurityTrails -> https://securitytrails.com/app/account/credentials
SECURITYTRAILS_API_KEY=

# AbuseIPDB    -> https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Shodan       -> https://account.shodan.io/
SHODAN_API_KEY=

# IPinfo       -> https://ipinfo.io/account/token
IPINFO_TOKEN=
